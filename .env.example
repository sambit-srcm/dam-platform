# Postgres
POSTGRES_USER=dam
POSTGRES_PASSWORD=dam_dev_password
POSTGRES_DB=dam
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=dam_dev_password
REDIS_PORT=6379

# MinIO (password must be at least 8 characters)
MINIO_ROOT_USER=dam
MINIO_ROOT_PASSWORD=dam_dev_password
MINIO_BUCKET=assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Connection strings for services/api
DATABASE_URL=postgres://dam:dam_dev_password@localhost:5432/dam
REDIS_URL=redis://:dam_dev_password@localhost:6379
MINIO_ENDPOINT=localhost

# RabbitMQ
RABBITMQ_USER=dam
RABBITMQ_PASSWORD=dam_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
AMQP_URL=amqp://dam:dam_dev_password@localhost:5672

# API
PORT=3000
LOG_LEVEL=info
# Origins allowed to call the API from a browser, comma separated
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
HEALTH_TIMEOUT_MS=2000
# Must stay below the stack's stop grace period (Swarm default 10s)
SHUTDOWN_TIMEOUT_MS=10000
# Keep equal to MAX_UPLOAD_MB in services/web/src/features/assets/api.ts
MAX_UPLOAD_MB=300

# Per-IP and per-user request limits, counted in Redis. Turn off only for local experiments.
RATE_LIMIT_ENABLED=true

# Auth: signs login tokens, generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
# Set true only when the site is served over HTTPS
COOKIE_SECURE=false
